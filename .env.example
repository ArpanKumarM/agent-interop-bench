# AgentTrust Phase 1 environment configuration
# Copy to .env and adjust as needed. No values are required to run the
# deterministic test suite or the mock MCP server.

# Logging
LOG_LEVEL=INFO

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Path to the benchmark suite loaded at API startup
BENCHMARKS_PATH=benchmarks/

# Reserved for future real-model adapters (not used in Phase 1)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
