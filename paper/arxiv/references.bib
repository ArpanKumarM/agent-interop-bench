@misc{mcphunt2026,
  title        = {{MCPHunt}: An Evaluation Framework for Cross-Boundary Data
                  Propagation in Multi-Server {MCP} Agents},
  author       = {Li, Haonan and Sun, Tianjun and Wang, Yongqing and
                  Zhang, Qisheng},
  year         = {2026},
  howpublished = {arXiv:2604.27819},
  note         = {\url{https://arxiv.org/abs/2604.27819}. Preprint, cs.AI,
                  submitted 30 April 2026; DOI 10.48550/arXiv.2604.27819.
                  Evaluation framework for how data propagates across MCP
                  server boundaries in multi-server MCP agents (cross-boundary
                  propagation / canary tracking within the MCP layer).
                  Distinction from this work: our setting explicitly composes
                  MCP with A2A --- the measured flow crosses from a local MCP
                  result into a remote A2A message --- and tests matched
                  confidential/public and remote-approval interventions.}
}

