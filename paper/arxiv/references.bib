@misc{mcp-spec,
  title        = {{Model Context Protocol} Specification (Revision 2025-06-18)},
  author       = {{Anthropic and Model Context Protocol contributors}},
  year         = {2025},
  howpublished = {\url{https://modelcontextprotocol.io/specification/2025-06-18}},
  note         = {Authoritative revision 2025-06-18, based on
                  \texttt{schema/2025-06-18/schema.ts}. Defines Hosts/Clients/Servers,
                  the ``Tools'' server feature (JSON-RPC \texttt{tools/call}), and
                  tool annotations (e.g. destructive / read-only hints), which the
                  spec states ``should be considered untrusted, unless obtained
                  from a trusted server.'' A later revision (2026-07-28) also exists.
                  The framework's local MCP fixture is implemented with the MCP
                  Python SDK, \texttt{mcp==2.0.0} in the frozen run environment
                  (resolved dependency lock SHA-256
                  \texttt{6b0d8279010a57be250d134ca291403061b4a8f7937fd2c93563ef9f6243fb56}).}
}

@misc{a2a-spec,
  title        = {{Agent2Agent (A2A) Protocol Specification, Version 1.0.0}},
  author       = {{A2A Project, Linux Foundation}},
  year         = {2026},
  howpublished = {\url{https://a2a-protocol.org/v1.0.0/specification/}},
  note         = {v1.0.0. Agent Card (Sec.~8); Task/TaskStatus/TaskState
                  (Sec.~4.1.1--4.1.3); Message and Part (Sec.~4.1.4, 4.1.6);
                  Artifact (Sec.~4.1.7); HTTP+JSON/REST protocol binding (Sec.~11).
                  Project hosted by the Linux Foundation since June 2025. The
                  framework's local A2A fixture implements the HTTP+JSON/REST
                  binding shapes only.}
}

