@misc{agentrfc2026,
  title        = {{AgentRFC}: Security Design Principles and Conformance Testing
                  for Agent Protocols},
  author       = {Zheng, Shenghan and Zhang, Qifan},
  year         = {2026},
  howpublished = {arXiv:2603.23801},
  note         = {\url{https://arxiv.org/abs/2603.23801}. Preprint, cs.CR,
                  submitted 25 March 2026; DOI 10.48550/arXiv.2603.23801.
                  Security design principles, TLA+ invariants, and conformance
                  checking for agent protocols, including the ``Composition
                  Safety'' principle --- ``security properties that hold for
                  individual protocols can break when protocols are composed
                  through shared infrastructure'' --- with formal (TLA+) models
                  of five cross-protocol composition patterns spanning
                  MCP/A2A/ANP/ACP, plus a spec-conformance checker
                  (AgentConform).}
}

@misc{mohiuddin2026mcpsec,
  title        = {Security Considerations for {Model Context Protocol} ({MCP})
                  Implementations in {AI} Agent Systems},
  author       = {Syed, Anas Mohiuddin},
  year         = {2026},
  howpublished = {IETF Internet-Draft draft-mohiuddin-mcp-security-considerations-00},
  note         = {\url{https://datatracker.ietf.org/doc/draft-mohiuddin-mcp-security-considerations/00/}.
                  June 2026, individual submission, Informational, version -00.
                  Section~6 (``Protocol Pivoting'') describes lateral movement
                  that crosses agent-protocol boundaries, ``combining MCP with
                  Agent-to-Agent (A2A) delegation,'' and states that
                  ``mitigations that consider each protocol in isolation do not
                  address movement that crosses protocol boundaries.''}
}

