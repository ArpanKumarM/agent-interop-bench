\bibitem[Zong et~al.(2026)Zong, Shen, Wang, Lan, and Yang]{mcpsafetybench2026}
Xuanjun Zong, Zhiqi Shen, Lei Wang, Yunshi Lan, and Chao Yang.
\newblock {MCP-SafetyBench}: A benchmark for safety evaluation of large language models with real-world {MCP} servers.
